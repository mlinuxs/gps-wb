.tabbar {
    background: #f6f8fa;
    border-top: 1rpx solid rgba(226,232,240,.9);
    box-sizing: initial;
    left: 0;
    padding-bottom: env(safe-area-inset-bottom);
    position: fixed;
    right: 0;
    z-index: 999
}

.tabbar,.tabbar-item {
    bottom: 0;
    height: 112rpx
}

.tabbar-item {
    -webkit-align-items: center;
    align-items: center;
    color: #2a2f2d;
    display: -webkit-flex;
    display: flex;
    -webkit-flex-direction: column;
    flex-direction: column;
    -webkit-justify-content: center;
    justify-content: center;
    position: absolute;
    top: 0;
    width: 25%
}

.tabbar-item-0 {
    left: 0
}

.tabbar-item-1 {
    left: 25%
}

.tabbar-item-2 {
    left: 50%
}

.tabbar-item-3 {
    left: 75%
}

.tabbar-icon {
    box-sizing: border-box;
    color: inherit;
    height: 50rpx;
    margin-bottom: 5rpx;
    position: relative;
    width: 50rpx
}

.tabbar-icon:after,.tabbar-icon:before {
    box-sizing: border-box;
    content: "";
    position: absolute
}

.tabbar-gear-icon {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    font-size: 58rpx;
    font-weight: 400;
    height: 56rpx;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 56rpx;
    -webkit-transform: translateY(-2rpx);
    transform: translateY(-2rpx);
    width: 60rpx
}

.tabbar-gear-icon:after,.tabbar-gear-icon:before {
    content: none
}

.tab-icon-realtime {
    border-bottom: 4rpx solid;
    border-left: 4rpx solid;
    border-radius: 0 0 0 4rpx
}

.tab-icon-realtime:before {
    background: currentColor;
    border-radius: 50%;
    box-shadow: 14rpx -14rpx 0 currentColor,30rpx -4rpx 0 currentColor;
    height: 11rpx;
    left: 7rpx;
    top: 25rpx;
    width: 11rpx
}

.tab-icon-realtime:after {
    border-right: 4rpx solid;
    border-top: 4rpx solid;
    height: 18rpx;
    left: 13rpx;
    top: 18rpx;
    -webkit-transform: skewY(-28deg);
    transform: skewY(-28deg);
    width: 32rpx
}

.tab-icon-params:before {
    border: 5rpx solid;
    border-radius: 50%;
    box-shadow: 0 -11rpx 0 -6rpx currentColor,0 11rpx 0 -6rpx currentColor,-11rpx 0 0 -6rpx currentColor,11rpx 0 0 -6rpx currentColor,8rpx 8rpx 0 -7rpx currentColor,-8rpx 8rpx 0 -7rpx currentColor,8rpx -8rpx 0 -7rpx currentColor,-8rpx -8rpx 0 -7rpx currentColor;
    height: 38rpx;
    width: 38rpx
}

.tab-icon-params:after,.tab-icon-params:before {
    left: 50%;
    top: 50%;
    -webkit-transform: translate(-50%,-50%);
    transform: translate(-50%,-50%)
}

.tab-icon-params:after {
    border: 4rpx solid;
    border-radius: 50%;
    height: 13rpx;
    width: 13rpx
}

.tab-icon-control:before {
    border: 4rpx solid;
    border-radius: 18rpx;
    height: 32rpx;
    left: 3rpx;
    top: 9rpx;
    width: 44rpx
}

.tab-icon-control:after {
    background: currentColor;
    border-radius: 50%;
    box-shadow: 17rpx 0 0 -5rpx currentColor;
    height: 16rpx;
    left: 11rpx;
    top: 17rpx;
    width: 16rpx
}

.tab-icon-mine:before {
    border: 4rpx solid;
    border-radius: 50%;
    height: 18rpx;
    left: 16rpx;
    top: 5rpx;
    width: 18rpx
}

.tab-icon-mine:after {
    border: 4rpx solid;
    border-bottom: 0;
    border-radius: 15rpx 15rpx 0 0;
    bottom: 6rpx;
    height: 22rpx;
    left: 10rpx;
    width: 30rpx
}

.tabbar-text {
    color: #2a2f2d;
    font-size: 25rpx;
    font-weight: 700;
    line-height: 33rpx
}
