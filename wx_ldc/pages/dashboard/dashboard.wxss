.state-tags-protect {
    -webkit-animation: protectPulse .9s ease-in-out infinite;
    animation: protectPulse .9s ease-in-out infinite;
    -webkit-transform-origin: center;
    transform-origin: center;
    will-change: transform,opacity
}

@-webkit-keyframes protectPulse {
    0%,100% {
        opacity: 1;
        -webkit-transform: scale(1);
        transform: scale(1)
    }

    50% {
        opacity: .7;
        -webkit-transform: scale(1.1);
        transform: scale(1.1)
    }
}

@keyframes protectPulse {
    0%,100% {
        opacity: 1;
        -webkit-transform: scale(1);
        transform: scale(1)
    }

    50% {
        opacity: .7;
        -webkit-transform: scale(1.1);
        transform: scale(1.1)
    }
}