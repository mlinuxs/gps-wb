page {
    background: #fff
}

.params-home {
    background: linear-gradient(to bottom,var(--theme-color) 0,var(--theme-color) 72rpx,#f6f8fa 72rpx,#f6f8fa 100%);
    min-height: 100vh;
    padding: 0 0 calc(150rpx + env(safe-area-inset-bottom))
}

.params-home > .app-head,.params-home > .disconnect-state,.params-home > .params-content {
    -webkit-transform: translateY(-36rpx);
    transform: translateY(-36rpx)
}

.params-content {
    padding: 18rpx 18rpx 40rpx
}

.param-section-title {
    color: var(--theme-color);
    font-size: 28rpx;
    font-weight: 800;
    line-height: 36rpx;
    margin: 22rpx 6rpx 12rpx
}

.param-section-toggle {
    -webkit-align-items: center;
    align-items: center;
    border-radius: 8rpx;
    box-sizing: border-box;
    display: -webkit-flex;
    display: flex;
    -webkit-justify-content: space-between;
    justify-content: space-between;
    min-height: 64rpx;
    padding: 0 12rpx
}

.param-section-toggle:active {
    background: #f1f5f9
}

.param-section-arrow {
    color: var(--theme-color);
    font-size: 42rpx;
    font-weight: 700;
    line-height: 42rpx;
    -webkit-transform: rotate(0deg);
    transform: rotate(0deg)
}

.param-section-arrow-open {
    -webkit-transform: rotate(90deg);
    transform: rotate(90deg)
}

.param-list {
    background: #fff;
    border: 1rpx solid #e2e8f0;
    border-radius: 8rpx;
    box-shadow: 0 8rpx 24rpx rgba(23,32,42,.04);
    overflow: hidden
}

.param-row {
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1rpx solid #e2e8f0;
    box-sizing: border-box;
    display: grid;
    gap: 20rpx;
    grid-template-columns: auto 1fr auto;
    min-height: 92rpx;
    padding: 0 22rpx
}

.param-row:last-child {
    border-bottom: 0
}

.param-row:active {
    background: #f8fafc
}

.param-icon {
    -webkit-align-items: center;
    align-items: center;
    background: #f1f5f9;
    border-radius: 8rpx;
    color: var(--theme-color);
    display: -webkit-flex;
    display: flex;
    font-size: 34rpx;
    font-weight: 800;
    height: 64rpx;
    -webkit-justify-content: center;
    justify-content: center;
    line-height: 1;
    width: 64rpx
}

.param-row.compact {
    min-height: 104rpx;
    padding-bottom: 12rpx;
    padding-top: 12rpx
}

.param-label {
    color: var(--theme-color);
    font-size: 29rpx;
    font-weight: 900;
    line-height: 38rpx
}

.param-addr {
    color: #9ca3af;
    font-size: 21rpx;
    line-height: 28rpx;
    margin-top: 4rpx
}

.param-side {
    -webkit-align-items: center;
    align-items: center;
    color: var(--theme-color);
    display: -webkit-flex;
    display: flex;
    font-size: 27rpx;
    font-weight: 700;
    gap: 14rpx;
    line-height: 34rpx;
    max-width: 330rpx;
    text-align: right
}

.param-side wx-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap
}

.param-arrow {
    color: var(--theme-color);
    font-size: 42rpx;
    font-weight: 400;
    line-height: 42rpx
}
