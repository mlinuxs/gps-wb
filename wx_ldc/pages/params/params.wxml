<view class="page params-home theme-root theme-{{themeIndex}}" style="{{themeStyle}}">
    <view class="theme-root theme-{{themeIndex}}" style="{{themeStyle}}">
        <view class="connect-fly-layer" wx:if="{{showConnectFly}}">
            <view class="connect-fly-icon connect-fly-search search-icon" style="{{connectFlySearchStyle}}"></view>
            <view class="connect-fly-icon connect-fly-camera camera-icon" style="{{connectFlyCameraStyle}}"></view>
        </view>
        <view class="app-head global-connect-head">
            <view catchtap="cycleTheme" class="theme-icon-button {{themeButtonStopped?'theme-icon-button-stopped':''}}"></view>
            <view class="head-device {{connectionStatus==='重连中：'?'head-status-reconnecting':''}}">{{connectionStatus}}</view>
            <view class="head-title">{{deviceName}}</view>
            <view catchtap="openDeviceList" class="head-action head-action-search search-icon"></view>
            <view catchtap="scanCode" class="head-action head-action-camera camera-icon"></view>
        </view>
        <view catchtap="closeThemePalette" class="theme-palette-mask" wx:if="{{showThemePalette}}"></view>
        <view catchtouchcancel="commitThemePalette" catchtouchend="commitThemePalette" catchtouchmove="touchThemePalette" catchtouchstart="touchThemePalette" class="theme-palette" wx:if="{{showThemePalette}}">
            <view catchtap="selectTheme" class="theme-swatch {{themeColor==item.color?'theme-swatch-active':''}}" data-color="{{item.color}}" style="background:{{item.color}};" wx:for="{{themeOptions}}" wx:key="index"></view>
        </view>
        <view class="disconnect-state" wx:if="{{!connected}}">
            <view class="connect-prompt-actions">
                <view catchtap="openDeviceList" class="connect-prompt-item">
                    <view class="connect-prompt-action search-icon"></view>
                    <view class="connect-prompt-label">手动连接</view>
                </view>
                <view catchtap="scanCode" class="connect-prompt-item">
                    <view class="connect-prompt-action camera-icon"></view>
                    <view class="connect-prompt-label">扫码连接</view>
                </view>
            </view>
            <view class="disconnect-title">蓝牙未连接</view>
            <view class="disconnect-sub">连接 BMS 后才能显示参数设置</view>
        </view>
        <view class="params-content" wx:else>
            <view class="param-section-title">常用设置</view>
            <view class="param-list">
                <view bindtap="openItem" class="param-row" data-name="快速设置" data-type="quick">
                    <view class="param-icon param-icon-quick">⚡</view>
                    <view class="param-label">快速设置</view>
                    <view class="param-arrow">›</view>
                </view>
            </view>
            <view bindtap="toggleSection" class="param-section-title param-section-toggle" data-key="showOtherParams">
                <text>此内参数非必要无需设置</text>
                <text class="param-section-arrow {{showOtherParams?'param-section-arrow-open':''}}">›</text>
            </view>
            <view class="param-list" wx:if="{{showOtherParams}}">
                <view bindtap="openItem" class="param-row" data-name="电压参数" data-type="voltage">
                    <view class="param-icon param-icon-voltage">V</view>
                    <view class="param-label">电压参数</view>
                    <view class="param-arrow">›</view>
                </view>
                <view bindtap="openItem" class="param-row" data-name="温度参数" data-type="temperature">
                    <view class="param-icon param-icon-temp">℃</view>
                    <view class="param-label">温度参数</view>
                    <view class="param-arrow">›</view>
                </view>
                <view bindtap="openItem" class="param-row" data-name="电流参数" data-type="current">
                    <view class="param-icon param-icon-current">A</view>
                    <view class="param-label">电流参数</view>
                    <view class="param-arrow">›</view>
                </view>
                <view bindtap="openItem" class="param-row" data-name="均衡参数" data-type="balance">
                    <view class="param-icon param-icon-balance">≡</view>
                    <view class="param-label">均衡参数</view>
                    <view class="param-arrow">›</view>
                </view>
                <view bindtap="openItem" class="param-row" data-name="线损补偿" data-type="wire">
                    <view class="param-icon param-icon-wire">Ω</view>
                    <view class="param-label">线损补偿</view>
                    <view class="param-arrow">›</view>
                </view>
                <view bindtap="openItem" class="param-row" data-name="系统参数" data-type="system">
                    <view class="param-icon param-icon-system">⚙</view>
                    <view class="param-label">系统参数</view>
                    <view class="param-arrow">›</view>
                </view>
            </view>
        </view>
    </view>
</view>
