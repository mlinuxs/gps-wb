.mode-panel {
    border-left: 8rpx solid var(--theme-color)
}

.mode-title {
    font-size: 34rpx;
    font-weight: 800;
    margin-bottom: 10rpx
}

.mode-desc,.mode-title {
    color: var(--theme-color)
}

.mode-desc {
    line-height: 1.7
}

.scan-actions {
    display: grid;
    gap: 16rpx;
    grid-template-columns: 1fr 1fr
}

.scan-actions .button:not(.secondary) {
    color: #fff
}

.stop-button {
    margin-top: 16rpx
}

.device {
    background: #fff;
    border: 1rpx solid #e2e8f0;
    border-radius: 8rpx;
    box-shadow: 0 8rpx 24rpx rgba(23,32,42,.04);
    margin-bottom: 16rpx;
    padding: 22rpx
}

.device:active {
    background: #f8fafc
}

.device-head {
    -webkit-align-items: center;
    align-items: center;
    display: -webkit-flex;
    display: flex;
    gap: 12rpx;
    margin-bottom: 10rpx
}

.device-name {
    color: var(--theme-color);
    -webkit-flex: 1;
    flex: 1;
    font-size: 31rpx;
    font-weight: 800;
    word-break: break-all
}

.device-meta {
    color: #6b7280;
    font-size: 22rpx;
    line-height: 1.6;
    word-break: break-all
}

.empty {
    color: var(--theme-color)
}
