.protection-record-page {
    padding-top: 34rpx
}

.record-card {
    padding: 30rpx 24rpx 80rpx
}

.section-title {
    color: var(--theme-color);
    font-size: 32rpx;
    font-weight: 800;
    margin: 0 0 22rpx
}

.record-table {
    border-left: 1rpx solid #cbd5e1;
    border-top: 1rpx solid #cbd5e1
}

.table-head,.table-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr
}

.table-head wx-view,.table-row wx-view {
    -webkit-align-items: center;
    align-items: center;
    border-bottom: 1rpx solid #cbd5e1;
    border-right: 1rpx solid #cbd5e1;
    box-sizing: border-box;
    color: var(--theme-color);
    display: -webkit-flex;
    display: flex;
    font-size: 24rpx;
    -webkit-justify-content: center;
    justify-content: center;
    min-height: 52rpx;
    padding: 8rpx 6rpx;
    text-align: center;
    word-break: break-all
}

.table-head wx-view {
    background: #f1f5f9;
    color: #6b7280;
    font-weight: 800;
    min-height: 58rpx
}

.table-row wx-view {
    color: var(--theme-color);
    font-weight: 800
}

.empty-text,.status-text {
    -webkit-align-items: center;
    align-items: center;
    color: var(--theme-color);
    display: -webkit-flex;
    display: flex;
    font-size: 28rpx;
    font-weight: 700;
    -webkit-justify-content: center;
    justify-content: center;
    min-height: 88rpx;
    text-align: center
}
